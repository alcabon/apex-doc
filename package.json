{
  "name": "@acabon/apexdoc",
  "version": "1.0.0",
  "description": "ApexDoc/JavaDoc style documentation generator for Salesforce Apex",
  "keywords": [
    "apex",
    "salesforce",
    "apexdoc",
    "javadoc",
    "documentation",
    "documentation-generator",
    "docs",
    "sfdx",
    "cli"
  ],
  "homepage": "https://github.com/alcabon/apex-doc#readme",
  "bugs": {
    "url": "https://github.com/alcabon/apex-doc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alcabon/apex-doc.git"
  },
  "author": "Alain Cabon",
  "license": "ISC",
  "type": "module",
  "main": "dist/apexdoc/index.js",
  "types": "dist/apexdoc/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/apexdoc/index.d.ts",
      "default": "./dist/apexdoc/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "apexdoc": "dist/apexdoc.js"
  },
  "files": [
    "dist/apexdoc.js",
    "dist/apexdoc.d.ts",
    "dist/apexdoc/"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build",
    "apexdoc": "node dist/apexdoc.js",
    "docs": "npm run build && node dist/apexdoc.js generate examples -o apexdocs -t \"Apex Demo\"",
    "check": "npm run build && node dist/apexdoc.js check examples --access private",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "prepublishOnly": "npm run clean && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@apexdevtools/apex-parser": "^4.4.1",
    "antlr4ts": "^0.5.0-alpha.4"
  }
}
